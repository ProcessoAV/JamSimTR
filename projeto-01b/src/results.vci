config image-path ../../../workspace/inet4.4/images
config network src.WifiJammingNetwork
config sim-time-limit 3s
config output-scalar-file results.sca
config output-vector-file results.vec
config record-eventlog true
config *.sender.wlan[0].mac.autoStart true
config *.receiver.wlan[0].mac.autoStart true
config *.receiver.app[0].startTime 0s
config *.configurator.typename Ipv4NetworkConfigurator
config *.configurator.addStaticRoutes true
config *.configurator.addDefaultRoutes true
config *.configurator.assignDisjunctSubnetAddresses true
config *.configurator.optimizeRoutes true
config *.configurator.verbose true
config *.**.routingTable.printRoutingTable true
config *.configurator.printAddresses true
config *.configurator.ignoreModuleNames "\"**.receiver\""
config *.receiver.hasIpv4 true
config *.receiver.wlan[0].ipv4.address "\"10.0.0.2\""
config *.receiver.wlan[0].ipv4.netmask "\"255.255.255.0\""
config *.receiver.app[0].typename UdpSink
config *.receiver.app[0].localPort 8080
config *.sender.numApps 1
config *.sender.app[0].typename UdpBasicApp
config *.sender.app[0].destAddresses "\"10.0.0.2\""
config *.sender.app[0].destPort 8080
config *.sender.app[0].messageLength 1000B
config *.sender.app[0].sendInterval 0.1s
config *.sender.app[0].startTime 0.08s
config *.sender.app[0].stopTime 1.9s
config *.sender.numWlanInterfaces 1
config *.receiver.numWlanInterfaces 1
config *.**.wlan[0].radio.transmitter.power 200mW
config *.**.wlan[0].radio.receiver.sensitivity -85dBm
config *.**.wlan[0].mac.ssid "\"testwifi\""
config *.**.wlan[0].mac.useAck true
config *.**.wlan[0].radio.mediumModule "\"^.radioMedium\""
config **.wlan[0].radio.displayCommunicationRange true
config *.visualizer.*.mediumVisualizer.displaySignals true
config *.visualizer.*.mediumVisualizer.signalPropagationAnimation true
config *.visualizer.*.mediumVisualizer.packetAnimation true
config *.visualizer.*.mediumVisualizer.displayCommunicationRanges true
config *.visualizer.*.mediumVisualizer.displayNoise true
config **.radio.interferenceNoisePower.vector-recording true
config *.radioMedium.backgroundNoise.power -110dBm
config *.radioMedium.typename DimensionalRadioMedium
config *.radioMedium.maxTransmissionDuration 2s
config *.**.ipv4.arp.typename GlobalArp
config *.**.routingTable.typename Ipv4RoutingTable
