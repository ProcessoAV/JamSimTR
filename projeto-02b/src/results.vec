config image-path ../../../workspace/inet4.4/images
config network src.recording
config description "Comunicação entre 2 hosts Wireless com um jammer no meio"
config sim-time-limit 20s
config output-scalar-file results.sca
config output-vector-file results.vec
config record-eventlog true
config *.host*.ipv4.arp.typename GlobalArp
config *.hostA.numApps 1
config *.hostA.app[0].typename UdpBasicApp
config *.hostA.app[0].destAddresses "\"hostB\""
config *.hostA.app[0].messageLength 1000B
config *.hostA.app[0].sendInterval exponential(12ms)
config *.hostA.app[0].packetName "\"UDPdata\""
config *.hostA.app[0].destPort 5000
config *.hostB*.numApps 1
config *.hostB.app[0].typename UdpSink
config *.hostB.app[0].localPort 5000
config *.host*.wlan[0].mac.useAck false
config *.host*.wlan[0].radio.receiver.ignoreInterference false
config *.host*.wlan[0].radio.typename ApskDimensionalRadio
config *.host*.**.bitrate 1Mbps
config *.host*.wlan[0].radio.centerFrequency 2.4GHz
config *.host*.wlan[0].radio.bandwidth 20MHz
config *.host*.wlan[0].radio.transmitter.power 2mW
config *.host*.wlan[0].radio.transmitter.preambleDuration 20us
config *.host*.wlan[0].radio.transmitter.headerLength 24bit
config *.host*.wlan[0].radio.receiver.snirThreshold 4dB
config *.host*.wlan[0].radio.receiver.energyDetection -85dBm
config *.host*.wlan[0].radio.receiver.sensitivity -90dBm
config *.host*.wlan[0].radio.receiver.centerFrequency 2.4GHz
config *.hostA.wlan[0].radio.typename ApskDimensionalRadio
config *.hostA.wlan[0].radio.transmitter.typename ApskDimensionalTransmitter
config *.hostA.wlan[0].radio.receiver.typename ApskDimensionalReceiver
config *.hostB.wlan[0].radio.typename ApskDimensionalRadio
config *.hostB.wlan[0].radio.transmitter.typename ApskDimensionalTransmitter
config *.hostB.wlan[0].radio.receiver.typename ApskDimensionalReceiver
config *.radioMedium.centerFrequency 2.4GHz
config *.radioMedium.bandwidth 20MHz
config **.radio.interferenceNoisePower.vector-recording false
config *.radioMedium.backgroundNoise.power -110dBm

